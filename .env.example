# Bootstrap admin (Railway / prod). Troca obrigatoria no primeiro acesso.
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=CcdTrocar123!
WP_ADMIN_EMAIL=admin@convivendocomdiabetes.com

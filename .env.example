# =============================================================================
# LOCALHOST ONLY — usado pelo Docker Compose (arquivo local: .env)
# Nao misturar com variaveis do Railway. Ver: .env.railway.example
# =============================================================================

# MySQL do container `db` (rede Docker interna)
WORDPRESS_DB_HOST=db:3306
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_NAME=convivend62e9f3c_ccd

# Senha root do MySQL local (so docker-compose service `db`)
MYSQL_ROOT_PASSWORD=rootpass

# URL do site no Docker (wp-config local costuma espelhar isto)
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080

# Google reCAPTCHA v2 — comentarios (dominio: localhost)
# https://www.google.com/recaptcha/admin (Checkbox v2)
CCD_RECAPTCHA_SITE_KEY=
CCD_RECAPTCHA_SECRET_KEY=

# 1 = forca re-copia de plugins/themes do host no boot do container
# Alternativa: .\scripts\sync-local-wp-content.ps1
SYNC_WP_CONTENT=0

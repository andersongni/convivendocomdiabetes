# =============================================================================
# RAILWAY ONLY — referencia das variaveis do servico WordPress no Railway
# NAO e carregado pelo Docker Compose. Configurar no dashboard Railway ou via
# IaC (.railway/railway.ts com preserve()) / Terraform.
# Dominio publico canonico: convivendocomdiabetes.com (www → 301 para o apex).
# =============================================================================

# --- Banco (MySQL gerenciado no Railway; em geral via referencia ao plugin) ---
# Ex.: WORDPRESS_DB_HOST=${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}
WORDPRESS_DB_HOST=
WORDPRESS_DB_USER=
WORDPRESS_DB_PASSWORD=
WORDPRESS_DB_NAME=

# --- Bootstrap admin (wp-boot.sh no primeiro install; trocar senha no 1o acesso) ---
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@convivendocomdiabetes.com

# Redis object cache (serviço Redis no Railway; refs tipicas)
# WP_REDIS_HOST=${{Redis.REDISHOST}}
# WP_REDIS_PORT=${{Redis.REDISPORT}}
# WP_REDIS_PASSWORD=${{Redis.REDIS_PASSWORD}}
# WP_REDIS_USERNAME=${{Redis.REDISUSER}}
# WP_REDIS_PREFIX=ccd_
WP_TITLE=Convivendo com Diabetes

# --- URL publica (canonica = apex sem www) ---
# Se vazio, prod-entrypoint usa https://$RAILWAY_PUBLIC_DOMAIN
WP_HOME=https://convivendocomdiabetes.com
WP_SITEURL=https://convivendocomdiabetes.com

# --- Salts WordPress (OBRIGATORIO em producao; estaveis entre deploys) ---
# Sem estes, wp-boot regenera AUTH/NONCE a cada boot e o wp-admin mostra
# "Este link expirou" ao excluir/salvar apos deploy. Gere uma vez e nao rotacione
# sem avisar (forca re-login). Ex.: openssl rand -base64 48
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=

# --- Google reCAPTCHA v2 — comentarios (dominios: apex + www) ---
CCD_RECAPTCHA_SITE_KEY=
CCD_RECAPTCHA_SECRET_KEY=

# --- Search Console (meta tag) — ver docs/SEO.md ---
# CCD_GOOGLE_SITE_VERIFICATION=

# --- UX/a11y (mu-plugin ccd-a11y; ativo por padrao em producao) ---
# CCD_A11Y_DISABLE=1

# --- Media optimize (mu-plugin ccd-media-optimize; quality 82, max 1920, WebP) ---
# CCD_MEDIA_OPTIMIZE_DISABLE=1
# CCD_MEDIA_WEBP_DISABLE=1

# --- CCD Backup → Google Drive (preferivel vincular no wp-admin) ---
# CCD_BACKUP_CLIENT_ID=
# CCD_BACKUP_CLIENT_SECRET=

# --- Injecao automatica pelo Railway (nao definir no dashboard) ---
# RAILWAY_PUBLIC_DOMAIN
# RAILWAY_PRIVATE_DOMAIN
# PORT
# MYSQLHOST / MYSQLPORT / MYSQLUSER / MYSQLPASSWORD / MYSQLDATABASE
#   (usados pelo prod-entrypoint se WORDPRESS_DB_* estiver vazio)

# --- Secrets do CI (GitHub Actions → Terraform), nao sao vars do servico WP ---
# RAILWAY_API_TOKEN  (ou RAILWAY_TOKEN)
# WP_ADMIN_PASSWORD  (tfvars / secret do workflow, se aplicavel)

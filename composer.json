{
  "name": "andersongni/convivendocomdiabetes",
  "description": "Testes unitarios dos mu-plugins CCD",
  "license": "MIT",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "infection/infection": "^0.29"
  },
  "autoload-dev": {
    "psr-4": {
      "Ccd\\Tests\\": "tests/",
      "Ccd\\": "wordpress/wp-content/mu-plugins/ccd-core/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "php -d pcov.directory=. phpunit --coverage-text --coverage-html=coverage/html --coverage-clover=coverage/clover.xml",
    "test:coverage:full": "php -d pcov.directory=. phpunit -c phpunit.coverage-full.xml.dist --coverage-text --coverage-html=coverage/html-full --coverage-clover=coverage/clover-full.xml",
    "test:mutation": "infection --threads=max --min-covered-msi=70 --ignore-msi-with-no-mutations --show-mutations"
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    },
    "platform": {
      "php": "8.3.35"
    }
  }
}

{
  "$schema": "https://raw.githubusercontent.com/infection/infection/0.29.14/resources/schema.json",
  "source": {
    "directories": ["wordpress/wp-content/mu-plugins/ccd-core"]
  },
  "timeout": 15,
  "logs": {
    "text": "coverage/infection.log",
    "html": "coverage/infection.html",
    "summary": "coverage/infection-summary.log"
  },
  "mutators": {
    "@default": true,
    "PregMatchRemoveFlags": false
  },
  "minMsi": 0,
  "minCoveredMsi": 70,
  "testFramework": "phpunit",
  "tmpDir": "/tmp/ccd-infection"
}

<?xml version="1.0" encoding="UTF-8"?>
<!-- Coverage de TODOS os mu-plugins (diagnostico). Padrao do dia a dia: phpunit.xml.dist (nucleo). -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="CCD Unit">
      <directory>tests/Unit</directory>
    </testsuite>
  </testsuites>
  <source>
    <include>
      <directory>wordpress/wp-content/mu-plugins</directory>
    </include>
    <exclude>
      <directory>wordpress/wp-content/mu-plugins/assets</directory>
    </exclude>
  </source>
</phpunit>
